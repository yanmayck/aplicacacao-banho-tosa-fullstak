# Arquivo de exemplo para variáveis de ambiente
# Copie este arquivo para .env e preencha com seus valores reais.
# Estas variáveis são usadas principalmente pelo docker-compose.yml para configurar os serviços.

# --- Configuração do Banco de Dados (PostgreSQL) ---
# Usado pelo serviço 'db' no docker-compose.yml e para construir a DATABASE_URL
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=furry_friends_db
POSTGRES_PORT=5435 # Porta do host para acessar o banco de dados Dockerizado

# --- Configuração do Backend ---
# URL de conexão completa para o Prisma e backend.
# Deve corresponder aos valores de POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB e a porta INTERNA do container (5432)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://admin:admin@db:5432/furry_friends_db?schema=public"

NODE_ENV=development # Ambiente da aplicação (development, production, test)
BACKEND_PORT=3333 # Porta em que o backend NestJS irá rodar

# Segredos para autenticação JWT
JWT_SECRET="coloque_um_segredo_forte_aqui"
JWT_EXPIRES_IN="1d" # Ex: 60s, 15m, 1h, 1d

# Configuração de CORS para o backend
# Lista de origens permitidas separadas por vírgula
# Para desenvolvimento local com o frontend em 5173 (Vite padrão) ou 8080 (configurado no docker-compose do frontend)
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080"

# --- Configuração do Frontend ---
# URL base da API que o frontend Vite usará para fazer requisições.
# Para desenvolvimento local, o frontend (rodando fora do Docker, ex: npm run dev)
# deve apontar para o backend na porta exposta pelo Docker ou rodando localmente.
VITE_API_BASE_URL="http://localhost:3333"

# Se você estiver rodando o frontend DENTRO do Docker (como configurado no docker-compose.yml),
# o VITE_API_BASE_URL dentro do container do frontend deve ser algo como "http://backend:3333",
# onde 'backend' é o nome do serviço do backend no Docker.
# Esta variável no .env raiz é principalmente para referência ou se você executar o frontend localmente.
# O docker-compose.yml para o serviço 'frontend' já define VITE_API_BASE_URL para o ambiente Docker.


# --- Outras Configurações (adicionar conforme necessário) ---
# Exemplo:
# ALGUMA_CHAVE_DE_API=seuvaloraqui
# OUTRO_SERVICO_URL=https://api.example.com
