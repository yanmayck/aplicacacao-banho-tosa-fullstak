# .env.example - Furry Friends Agenda
# Copie este arquivo para .env e preencha com seus valores.

#---------------------------------------------------------------------------
# Variáveis Comuns (usadas em ambos os ambientes)
#---------------------------------------------------------------------------

# JWT Authentication
# IMPORTANTE: Troque este valor em produção por uma string segura e aleatória!
JWT_SECRET="9f3c64e1f6effe62e387eff3ad321785cedfcb22c7e190c47a0a2a28674ae4b" # Mínimo de 32 caracteres
JWT_EXPIRES_IN="1d" # Expiração do token (ex: 1h, 1d, 7d)

# Porta do Backend
BACKEND_PORT=3333

# URL base da API para o frontend
# Em desenvolvimento (docker-compose.dev.yml), o frontend acessa o backend via http://localhost:3333
# Em produção, você deve alterar para a URL pública do seu backend (ex: https://api.seusite.com)
VITE_API_BASE_URL=http://localhost:3333

#---------------------------------------------------------------------------
# Ambiente de Desenvolvimento (docker-compose.dev.yml)
#---------------------------------------------------------------------------

# Configuração do banco de dados PostgreSQL que será criado pelo Docker
POSTGRES_USER=petshop
POSTGRES_PASSWORD=petshplogic
POSTGRES_DB=furryfriends_agenda

# URL de conexão para o Prisma (usada pelo backend para conectar no DB do Docker)
# Não altere esta linha para o ambiente de desenvolvimento
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?schema=public"

# Origens permitidas para o CORS em desenvolvimento
CORS_ALLOWED_ORIGINS="http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173"

# Define o ambiente para o Node.js
NODE_ENV=development

#---------------------------------------------------------------------------
# Ambiente de Produção (docker-compose.prod.yml)
#---------------------------------------------------------------------------

# Em produção, você deve descomentar e preencher as variáveis abaixo.
# A URL do banco de dados DEVE apontar para seu banco de dados externo (ex: AWS RDS, Google Cloud SQL).

# Exemplo de DATABASE_URL para um banco de dados de produção:
# DATABASE_URL="postgresql://usuario_prod:senha_prod@host-do-banco.com:5432/nome_do_banco_prod?schema=public"

# As origens do CORS em produção devem ser a URL do seu frontend.
# Exemplo:
# CORS_ALLOWED_ORIGINS="https://www.seusite.com"

# Em produção, o NODE_ENV deve ser 'production'.
# NODE_ENV=production