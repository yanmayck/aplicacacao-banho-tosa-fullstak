# ========================================
# CONFIGURAÇÕES DE AMBIENTE
# ========================================

# Define o ambiente da aplicação. Opções: development, production, test
NODE_ENV=development

# ========================================
# CONFIGURAÇÕES DO BACKEND (NESTJS)
# ========================================

# Porta em que o servidor backend irá escutar
BACKEND_PORT=3333

# URL base da aplicação backend (para produção)
APP_URL=http://localhost:3333

# JWT Authentication
# Chave secreta para assinatura de tokens JWT. MUDE ESTA CHAVE EM PRODUÇÃO!
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
# Tempo de expiração do token JWT (ex: 1h, 1d, 7d)
JWT_EXPIRES_IN="1d"

# CORS (Cross-Origin Resource Sharing)
# Lista de origens permitidas para requisições CORS, separadas por vírgula.
# Ex: http://localhost:5173,http://127.0.0.1:5173,https://seusite.com
CORS_ALLOWED_ORIGINS="http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173"

# ========================================
# CONFIGURAÇÕES DO BANCO DE DADOS (POSTGRESQL)
# ========================================

# Nome de usuário para o banco de dados PostgreSQL
POSTGRES_USER=petshop
# Senha para o usuário do banco de dados PostgreSQL
POSTGRES_PASSWORD=petshplogic
# Nome do banco de dados PostgreSQL
POSTGRES_DB=furryfriends_agenda
# Porta externa mapeada para o PostgreSQL no Docker
POSTGRES_PORT=5432

# URL de conexão completa com o banco de dados.
# Para desenvolvimento local com Docker, o host é 'db'.
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?schema=public"
# Exemplo para produção:
# DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# ========================================
# CONFIGURAÇÕES DO FRONTEND (REACT/VITE)
# ========================================

# Porta em que o servidor de desenvolvimento frontend irá escutar
FRONTEND_PORT=5173

# URL da API do backend para o frontend.
# Em desenvolvimento local, pode ser o localhost. Em Docker, usa o nome do serviço.
VITE_API_BASE_URL=http://localhost:3333
# URL base da aplicação frontend (para produção)
VITE_APP_URL=http://localhost:5173

# Variável opcional para resolver problemas de HMR do Vite em alguns setups Docker
# CHOKIDAR_USEPOLLING=true

# ========================================
# CONFIGURAÇÕES DE PAGAMENTO (STRIPE)
# ========================================

# Chave secreta da API do Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
# Chave secreta para webhooks do Stripe
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
# Habilita ou desabilita a funcionalidade de faturamento do Stripe (true/false)
STRIPE_BILLING_ENABLED="false"

# ========================================
# CONFIGURAÇÕES DE NOTIFICAÇÕES
# ========================================

# SendGrid (Email)
SENDGRID_API_KEY="SG.your_sendgrid_api_key_here"
SENDGRID_FROM_EMAIL="noreply@yourdomain.com"
SENDGRID_FROM_NAME="Your App Name"

# Twilio (SMS e WhatsApp)
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# ========================================
# CONFIGURAÇÕES OPCIONAIS DE DESENVOLVIMENTO/PRODUÇÃO
# ========================================

# Modo de depuração (true/false)
DEBUG=true
# Nível de log (error, warn, info, debug)
LOG_LEVEL=info

# Rate limiting (requests por minuto)
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Tempo limite de sessão (em minutos)
SESSION_TIMEOUT=480

# Limites de upload de arquivos (em bytes)
MAX_FILE_SIZE=10485760
# Tipos de arquivo permitidos (separados por vírgula)
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/gif,application/pdf"

# ========================================
# BACKUP E ARMAZENAMENTO
# ========================================

# Habilita ou desabilita backups automáticos (true/false)
BACKUP_ENABLED=true
# Cron schedule para backups (ex: "0 2 * * *" para diariamente às 2h)
BACKUP_SCHEDULE="0 2 * * *"
# Número de dias para reter os backups
BACKUP_RETENTION_DAYS=30

# ========================================
# CONFIGURAÇÕES DE EMAIL (ALTERNATIVAS - CASO NÃO USE SENDGRID)
# ========================================

# Host SMTP
SMTP_HOST="smtp.gmail.com"
# Porta SMTP
SMTP_PORT=587
# Usar conexão segura (true/false)
SMTP_SECURE=false
# Usuário SMTP
SMTP_USER="your-email@gmail.com"
# Senha SMTP
SMTP_PASS="your-app-password"

# ========================================
# REDIS (OPCIONAL - PARA CACHE E SESSIONS)
# ========================================

# URL de conexão Redis
# REDIS_URL="redis://localhost:6379"
# Senha Redis
# REDIS_PASSWORD=""
# Banco de dados Redis
# REDIS_DB=0

# ========================================
# ARMAZENAMENTO DE ARQUIVOS (OPCIONAL - EX: AWS S3)
# ========================================

# AWS Access Key ID
# AWS_ACCESS_KEY_ID="your_aws_access_key"
# AWS Secret Access Key
# AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
# Região AWS
# AWS_REGION="us-east-1"
# Nome do bucket S3
# S3_BUCKET_NAME="your-bucket-name"

# ========================================
# MONITORAMENTO E LOGGING (OPCIONAL)
# ========================================

# Sentry DSN para rastreamento de erros
# SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"