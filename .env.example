# ========================================
# CONFIGURAÇÕES DE AMBIENTE - EXEMPLO
# ========================================
NODE_ENV=development

# ========================================
# BACKEND (NESTJS) - CONFIGURAÇÕES PRINCIPAIS
# ========================================

# Porta do servidor backend
PORT=3333

# URL da aplicação (para produção)
APP_URL=http://localhost:3333

# ========================================
# BANCO DE DADOS (POSTGRESQL)
# ========================================

# URL de conexão com PostgreSQL
# Para desenvolvimento local:
DATABASE_URL="postgresql://username:password@localhost:5432/furry_friends_db?schema=public"

# Para produção (exemplo com variáveis de ambiente):
# DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# ========================================
# AUTENTICAÇÃO E SEGURANÇA
# ========================================

# JWT Secret - MUDE ESTA CHAVE EM PRODUÇÃO!
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Tempo de expiração do JWT (em segundos)
JWT_EXPIRES_IN=3600

# ========================================
# CORS - ORIGENS PERMITIDAS
# ========================================

# Origens permitidas para CORS (separadas por vírgula)
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# ========================================
# NOTIFICAÇÕES
# ========================================

# SendGrid (Email)
SENDGRID_API_KEY="SG.your_sendgrid_api_key_here"
SENDGRID_FROM_EMAIL="noreply@yourdomain.com"
SENDGRID_FROM_NAME="Your App Name"

# Twilio (SMS e WhatsApp)
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# ========================================
# FRONTEND (REACT/VITE) - CONFIGURAÇÕES
# ========================================

# Porta do servidor de desenvolvimento frontend
FRONTEND_PORT=5173

# URL da API do backend
VITE_API_URL="http://localhost:3333"

# URL do frontend (para produção)
VITE_APP_URL="http://localhost:5173"

# ========================================
# CONFIGURAÇÕES DE DESENVOLVIMENTO
# ========================================

# Debug mode
DEBUG=true

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# ========================================
# CONFIGURAÇÕES DE PRODUÇÃO
# ========================================

# Para produção, configure estas variáveis:
# NODE_ENV=production
# DATABASE_URL com suas credenciais reais
# JWT_SECRET com chave segura e única
# CORS_ALLOWED_ORIGINS com seus domínios reais
# SENDGRID_API_KEY e TWILIO credentials reais

# ========================================
# CONFIGURAÇÕES OPCIONAIS
# ========================================

# Rate limiting (requests por minuto)
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Session timeout (em minutos)
SESSION_TIMEOUT=480

# File upload limits
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/gif,application/pdf"

# ========================================
# BACKUP E ARMAZENAMENTO
# ========================================

# Configurações de backup automático
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Diariamente às 2h
BACKUP_RETENTION_DAYS=30

# ========================================
# CONFIGURAÇÕES DE EMAIL (ALTERNATIVAS)
# ========================================

# SMTP alternativo (caso não use SendGrid)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# ========================================
# REDIS (OPCIONAL - PARA CACHE E SESSIONS)
# ========================================

# REDIS_URL="redis://localhost:6379"
# REDIS_PASSWORD=""
# REDIS_DB=0

# ========================================
# ARMAZENAMENTO DE ARQUIVOS (OPCIONAL)
# ========================================

# AWS S3 ou similar para armazenamento de arquivos
# AWS_ACCESS_KEY_ID="your_aws_access_key"
# AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
# AWS_REGION="us-east-1"
# S3_BUCKET_NAME="your-bucket-name"

# ========================================
# MONITORAMENTO E LOGGING (OPCIONAL)
# ========================================

# Sentry DSN para error tracking
# SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"