# Root .env.example file for Furry Friends Agenda
# Copy this file to .env and fill in your actual values.

# ====== PostgreSQL Database Configuration ======
# Used by the 'db' service in docker-compose.yml and by the backend to connect.
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_strong_postgres_password
POSTGRES_DB=furryfriends_agenda
POSTGRES_PORT=5432 # Host port to map to the container's 5432 port

# ====== Backend Configuration (NestJS) ======
# Database connection URL used by Prisma.
# Ensure the user, password, db name, and service name ('db') match your PostgreSQL setup.
# The port here is the internal Docker network port for PostgreSQL (5432).
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?schema=public"

NODE_ENV=development # Options: development, production, test
BACKEND_PORT=3333 # Port the backend server will listen on

# JWT Authentication
JWT_SECRET="replace_this_with_a_very_strong_random_secret_key" # Minimum 32 characters recommended
JWT_EXPIRES_IN="1d" # Example: 1h, 1d, 7d

# CORS (Cross-Origin Resource Sharing)
# Comma-separated list of allowed origins.
# For development with Vite frontend on 8080 (or 5173 if default):
CORS_ALLOWED_ORIGINS="http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173"
# Add your production frontend URL here when deploying, e.g., https://yourfrontend.com

# ====== Frontend Configuration (Vite) ======
# Base URL for the API.
# When running locally with docker-compose, this should point to the backend service name and port.
# VITE_API_BASE_URL is set directly in docker-compose.yml for the frontend service
# to ensure it uses the correct internal Docker network URL (http://backend:3333).
# If running the frontend outside Docker (e.g., `npm run dev` locally) while the backend is in Docker,
# you would set this to:
# VITE_API_BASE_URL=http://localhost:3333
# For this .env.example, we'll keep the localhost version as a common scenario.
VITE_API_BASE_URL=http://localhost:3333

# Optional: For Vite HMR issues in some Docker setups
# CHOKIDAR_USEPOLLING=true
